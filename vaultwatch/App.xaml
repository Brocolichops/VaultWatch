<Application x:Class="VaultWatch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="DeepNavyBrush" Color="#071426" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D223B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1D5A86" />
        <SolidColorBrush x:Key="ElectricBlueBrush" Color="#1688D4" />
        <SolidColorBrush x:Key="BrightCyanBrush" Color="#52D6FF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#D9F5FF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#80AFC4" />
        <SolidColorBrush x:Key="GridRowBrush" Color="#0B1C32" />
        <SolidColorBrush x:Key="GridAlternateRowBrush" Color="#102A46" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ElectricBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrightCyanBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource GridRowBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource GridAlternateRowBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ElectricBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BrightCyanBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Application.Resources>
</Application>

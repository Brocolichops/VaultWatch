<Window x:Class="VaultWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VaultWatch // Message Monitor"
        Height="560"
        Width="980"
        MinHeight="400"
        MinWidth="720"
        Background="{StaticResource DeepNavyBrush}"
        FontFamily="Consolas">
    <Window.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="DoorStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrightCyanBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="False">
                    <Setter Property="Foreground" Value="#FFB454" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLockdownActive}" Value="True">
                    <Setter Property="Foreground" Value="#FFFF7066" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GridRowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLockdownActive}" Value="True">
                    <Setter Property="Background" Value="#FF3A151B" />
                    <Setter Property="BorderBrush" Value="#FFFF4038" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrightCyanBrush}"
                           Text="VAULTWATCH" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="// REAL-TIME DEVICE MESSAGE MONITOR" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource BrightCyanBrush}"
                       Text="● SYSTEM ONLINE" />
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="16"
                Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Width="190"
                        Height="38"
                        Click="SendMessages_Click"
                        Content="SEND SENSOR MESSAGES" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="MESSAGE BUS STATUS" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrightCyanBrush}"
                               Text="LISTENING FOR DEVICE EVENTS..." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PanelBorderStyle}"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Width="210"
                            Height="34"
                            Background="#FF8F3D"
                            BorderBrush="#FFFFC27D"
                            Click="InitiateLockdown_Click"
                            Content="INITIATE LOCKDOWN" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="0,0,16,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Text="LOCAL CONTROL CHANNEL" />
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="SECURITY ACCESS CONTROL" />
                </DockPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding DoorLocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="205"
                                    Margin="0,0,10,0"
                                    Padding="12"
                                    Style="{StaticResource DoorCardStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="Bold"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="0,5,0,10"
                                               FontSize="11"
                                               Style="{StaticResource DoorStatusStyle}"
                                               Text="{Binding StatusText}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource DoorActionButtonStyle}"
                                                Margin="0,0,8,0"
                                                Tag="{Binding}"
                                                Click="LockDoor_Click"
                                                Content="LOCK" />
                                        <Button Style="{StaticResource DoorActionButtonStyle}"
                                                Tag="{Binding}"
                                                Click="UnlockDoor_Click"
                                                Content="UNLOCK" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="LockdownStatusText"
                           Grid.Row="2"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="LOCKDOWN STANDBY // AUTHORIZATION REQUIRED" />

                <Border x:Name="LockdownBanner"
                        Grid.Row="3"
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="#FF651B24"
                        BorderBrush="#FFFF4038"
                        BorderThickness="2"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFF7066"
                                   Text="!!! LOCKDOWN ACTIVE !!!" />
                        <TextBlock Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="White"
                                   Text="ALL ACCESS POINTS SECURED // SILENT SOS SIMULATION ACTIVE" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}" Padding="1">
            <DataGrid ItemsSource="{Binding Messages}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding Time, StringFormat={}{0:u}}" Width="190" />
                    <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="130" />
                    <DataGridTextColumn Header="MODULE" Binding="{Binding ModuleName}" Width="*" />
                    <DataGridTextColumn Header="MESSAGE TYPE" Binding="{Binding MessageType}" Width="*" />
                    <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
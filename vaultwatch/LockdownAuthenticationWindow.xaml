<Window x:Class="VaultWatch.LockdownAuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lockdown Authentication"
        Width="460"
        Height="430"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DeepNavyBrush}"
        FontFamily="Consolas">
    <Border Margin="18"
            Padding="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#FFB454"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FFFFB454"
                       Text="LOCKDOWN AUTHORIZATION" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="This action will lock every configured door and display a simulated silent SOS notification." />

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,5"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="TYPE INITIATE LOCKDOWN TO CONTINUE" />
            <TextBox x:Name="ConfirmationTextBox"
                     Grid.Row="3"
                     Height="32"
                     Padding="8,5"
                     Background="{StaticResource DeepNavyBrush}"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     BorderBrush="{StaticResource PanelBorderBrush}"
                     FontFamily="Consolas" />

            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <TextBlock Margin="0,0,0,5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="SECURITY PIN" />
                <PasswordBox x:Name="PinBox"
                             Height="32"
                             Padding="8,5"
                             Background="{StaticResource DeepNavyBrush}"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             BorderBrush="{StaticResource PanelBorderBrush}"
                             FontFamily="Consolas" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Demo PIN: 2468" />
                <TextBlock x:Name="ErrorTextBlock"
                           Margin="0,8,0,0"
                           Foreground="#FFFF7066"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"
                        Content="CANCEL" />
                <Button Width="150"
                        Height="32"
                        Background="#FFB454"
                        BorderBrush="#FFFFD18A"
                        Click="Authorize_Click"
                        Content="AUTHORIZE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
